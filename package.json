{
  "name": "smartmonkey",
  "version": "1.0.0",
  "description": "A TamperMonkey plugin to alter Smartschool.",
  "main": "SmartMonkey.js",
  "type": "module",
  "scripts": {
    "build": "esbuild src/Core/SmartMonkey.ts --bundle --outfile=dist/SmartMonkey.js --format=iife --global-name=SmartMonkey --minify",
    "build:dev": "esbuild src/Core/SmartMonkey.ts --bundle --outfile=dist/SmartMonkey.js --format=iife --global-name=SmartMonkey --watch",
    "serve": "cd dist; http-server -p 8080",
    "dev": "concurrently \"npm run build:dev\" \"npm run serve\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "dependencies": {
    "zod": "^4.6.4"
  }
}